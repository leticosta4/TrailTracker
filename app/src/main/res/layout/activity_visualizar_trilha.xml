<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VisualizarTrilhaActivity">

    <TextView
        android:id="@+id/cabecalho"
        style="@style/Widget.App.Header"
        android:text="@string/title_view_trail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cabecalho" />

    <LinearLayout
        android:id="@+id/painel_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_painel"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/info_nome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="@color/foreground"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Morning walk" />

        <LinearLayout
            style="@style/Widget.App.InfoRow">

            <TextView
                style="@style/Widget.App.InfoLabel"
                android:text="@string/view_started" />

            <TextView
                android:id="@+id/info_inicio"
                style="@style/Widget.App.InfoValue"
                tools:text="11/23/26, 8:10 AM" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.App.InfoRow">

            <TextView
                style="@style/Widget.App.InfoLabel"
                android:text="@string/view_avg_speed" />

            <TextView
                android:id="@+id/info_vel_media"
                style="@style/Widget.App.InfoValue"
                tools:text="4.8 km/h" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.App.InfoRow">

            <TextView
                style="@style/Widget.App.InfoLabel"
                android:text="@string/view_max_speed" />

            <TextView
                android:id="@+id/info_vel_maxima"
                style="@style/Widget.App.InfoValue"
                tools:text="7.2 km/h" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.App.InfoRow">

            <TextView
                style="@style/Widget.App.InfoLabel"
                android:text="@string/view_distance" />

            <TextView
                android:id="@+id/info_distancia"
                style="@style/Widget.App.InfoValue"
                tools:text="1.25 km" />
        </LinearLayout>

        <LinearLayout
            style="@style/Widget.App.InfoRow">

            <TextView
                style="@style/Widget.App.InfoLabel"
                android:text="@string/view_duration" />

            <TextView
                android:id="@+id/info_duracao"
                style="@style/Widget.App.InfoValue"
                tools:text="00:15:30" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
