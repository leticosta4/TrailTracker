<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ConfiguracaoActivity">

    <TextView
        android:id="@+id/cabecalho"
        style="@style/Widget.App.Header"
        android:layout_width="match_parent"
        android:text="@string/title_settings" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                style="@style/Widget.App.SectionLabel"
                android:text="@string/map_type_label" />

            <RadioGroup
                android:id="@+id/radio_group_mapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_vetorial"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/map_type_vector" />

                <RadioButton
                    android:id="@+id/radio_satelite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/map_type_satellite" />
            </RadioGroup>

            <TextView
                style="@style/Widget.App.SectionLabel"
                android:layout_marginTop="32dp"
                android:text="@string/navigation_label" />

            <RadioGroup
                android:id="@+id/radio_group_navegacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/radio_north_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/navigation_north_up" />

                <RadioButton
                    android:id="@+id/radio_course_up"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/navigation_course_up" />
            </RadioGroup>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/navigation_help"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/button_aplicar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/apply" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
