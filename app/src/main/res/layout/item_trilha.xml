<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_campo"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/item_nome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/foreground"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Morning walk" />

    <TextView
        android:id="@+id/item_resumo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="13sp"
        tools:text="11/23/26, 8:10 AM · 1.25 km" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/item_ver"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trails_view"
            android:textSize="13sp" />

        <Button
            android:id="@+id/item_editar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trails_edit"
            android:textSize="13sp" />

        <Button
            android:id="@+id/item_apagar"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trails_delete"
            android:textColor="@color/stop"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
